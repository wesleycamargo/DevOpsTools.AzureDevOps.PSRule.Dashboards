{
  "name": "PSRule",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Config",
        "isHidden": true,
        "columns": [],
        "partitions": [
          {
            "name": "Config",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Config = [Organization=\"YOUR_ORGANIZATION\", Project=\"YOUR_AZDO_PROJECT\", PipelineDefinitionId=0, ArtifactName=\"psrule-results\", SarifFileName=\"psrule-results.sarif\", RawArtifactName=\"AzureDevOpsRawData\", MaxBuilds=1]\nin\n    Config"
            }
          }
        ],
        "lineageTag": "c14cf1c0-7d3e-436f-a51c-0395d98fdb65"
      },
      {
        "name": "Builds",
        "isHidden": false,
        "columns": [
          {
            "name": "id",
            "dataType": "int64",
            "sourceColumn": "id",
            "lineageTag": "4b604eb8-898d-41a8-be05-450ddea0936f"
          },
          {
            "name": "buildNumber",
            "dataType": "string",
            "sourceColumn": "buildNumber",
            "lineageTag": "4de22989-eb39-47cb-8f76-87beef3c5dcf"
          },
          {
            "name": "finishTime",
            "dataType": "string",
            "sourceColumn": "finishTime",
            "lineageTag": "32b85895-47e7-4ee2-8814-10d408292f8"
          },
          {
            "name": "result",
            "dataType": "string",
            "sourceColumn": "result",
            "lineageTag": "7ccca636-b9c3-4a3c-aff3-ccd68516f31a"
          }
        ],
        "partitions": [
          {
            "name": "Builds",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n  C=Config,\n  Valid=if C[PipelineDefinitionId]=0 then error \"Configure PipelineDefinitionId in Config\" else true,\n  R=if Valid then fxAzDoGet(C[Organization]&\"/\"&Uri.EscapeDataString(C[Project])&\"/_apis/build/builds\", [definitions=Text.From(C[PipelineDefinitionId]), statusFilter=\"completed\", queryOrder=\"finishTimeDescending\", #\"$top\"=Text.From(C[MaxBuilds])]) else null,\n  L=R[value],\n  T=Table.FromRecords(L, null, MissingField.UseNull),\n  Output=Table.SelectColumns(T,{\"id\",\"buildNumber\",\"finishTime\",\"result\"}, MissingField.UseNull)\nin Output"
            }
          }
        ],
        "lineageTag": "16f9543f-a51e-4ca7-ab1d-e7054dc8f00d"
      },
      {
        "name": "AssessmentResults",
        "isHidden": false,
        "columns": [
          {
            "name": "BuildId",
            "dataType": "int64",
            "sourceColumn": "BuildId",
            "lineageTag": "fe5db2c4-82fc-49c8-8a0b-6e8f7701d226"
          },
          {
            "name": "BuildNumber",
            "dataType": "string",
            "sourceColumn": "BuildNumber",
            "lineageTag": "20c4f4a6-3fbb-41d7-8c49-54f221a7081e"
          },
          {
            "name": "RuleId",
            "dataType": "string",
            "sourceColumn": "RuleId",
            "lineageTag": "db372f45-c589-4cd3-a6c6-eb83dfbc81b7"
          },
          {
            "name": "Level",
            "dataType": "string",
            "sourceColumn": "Level",
            "lineageTag": "b2b226e3-1cda-4509-ac4b-a4a986ff7aa0"
          },
          {
            "name": "Kind",
            "dataType": "string",
            "sourceColumn": "Kind",
            "lineageTag": "2186b0b1-e926-4f90-baed-41b95aa15be6"
          },
          {
            "name": "Message",
            "dataType": "string",
            "sourceColumn": "Message",
            "lineageTag": "6ab4f4be-03c6-4bbb-b3da-78f5ac8b9de4"
          },
          {
            "name": "TargetUri",
            "dataType": "string",
            "sourceColumn": "TargetUri",
            "lineageTag": "f93c1ec7-6e93-482f-a8d5-03a028830bce"
          }
        ],
        "partitions": [
          {
            "name": "AssessmentResults",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n  Bs=Table.ToRecords(Builds),\n  Rows=List.Combine(List.Transform(Bs,(b)=>\n    let\n      Sarif=fxArtifactSarif(b[id]),\n      Runs=Record.FieldOrDefault(Sarif,\"runs\",{}),\n      Found=List.Combine(List.Transform(Runs,(run)=>List.Transform(Record.FieldOrDefault(run,\"results\",{}),(r)=>\n        let\n          Msg=Record.FieldOrDefault(r,\"message\",[]),\n          Locs=Record.FieldOrDefault(r,\"locations\",{}),\n          Loc=if List.Count(Locs)>0 then Locs{0} else [],\n          Ph=Record.FieldOrDefault(Loc,\"physicalLocation\",[]),\n          Ar=Record.FieldOrDefault(Ph,\"artifactLocation\",[])\n        in [BuildId=b[id],BuildNumber=b[buildNumber],RuleId=Record.FieldOrDefault(r,\"ruleId\",null),Level=Record.FieldOrDefault(r,\"level\",null),Kind=Record.FieldOrDefault(r,\"kind\",null),Message=Record.FieldOrDefault(Msg,\"text\",null),TargetUri=Record.FieldOrDefault(Ar,\"uri\",null)]\n      )))\n    in Found\n  )),\n  Output=if List.Count(Rows)=0 then #table({\"BuildId\",\"BuildNumber\",\"RuleId\",\"Level\",\"Kind\",\"Message\",\"TargetUri\"},{}) else Table.FromRecords(Rows)\nin Output"
            }
          }
        ],
        "measures": [
          {
            "name": "Reported Findings",
            "expression": "COUNTROWS(AssessmentResults)",
            "formatString": "#,0"
          },
          {
            "name": "Affected Rules",
            "expression": "DISTINCTCOUNT(AssessmentResults[RuleId])",
            "formatString": "#,0"
          },
          {
            "name": "Error Findings",
            "expression": "CALCULATE([Reported Findings], AssessmentResults[Level] = \"error\")",
            "formatString": "#,0"
          }
        ],
        "lineageTag": "4715acc5-db69-43a2-92ef-217630e99147"
      },
      {
        "name": "RawFiles",
        "columns": [
          {
            "name": "BuildId",
            "dataType": "int64",
            "sourceColumn": "BuildId"
          },
          {
            "name": "FilePath",
            "dataType": "string",
            "sourceColumn": "FilePath"
          },
          {
            "name": "RawJson",
            "dataType": "binary",
            "sourceColumn": "RawJson"
          }
        ],
        "partitions": [
          {
            "name": "RawFiles",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n  Runs=Table.ToRecords(Builds),\n  Tables=List.Transform(Runs, each fxRawJsonFiles(_[id])),\n  Combined=if List.Count(Tables)=0 then #table({\"BuildId\",\"FilePath\",\"RawJson\",\"Data\"},{}) else Table.Combine(Tables),\n  Output=Table.SelectColumns(Combined,{\"BuildId\",\"FilePath\",\"RawJson\"},MissingField.UseNull)\nin Output"
            }
          }
        ]
      }
    ],
    "expressions": [
      {
        "name": "fxAzDoGet",
        "kind": "m",
        "expression": "(path as text, q as record) as any => Json.Document(Web.Contents(\"https://dev.azure.com\", [RelativePath=path, Query=Record.Combine({[#\"api-version\"=\"7.1\"],q}), Headers=[Accept=\"application/json\"]]))",
        "lineageTag": "a1cdfb02-74eb-46a4-b516-ae9184baaa3e"
      },
      {
        "name": "fxArtifactSarif",
        "kind": "m",
        "expression": "(buildId as number) as record =>\nlet\n C=Config,\n Path=C[Organization]&\"/\"&Uri.EscapeDataString(C[Project])&\"/_apis/build/builds/\"&Text.From(buildId)&\"/artifacts\",\n Info=fxAzDoGet(Path,[artifactName=C[ArtifactName]]),\n Res=Info[resource],\n Type=Text.Lower(Text.From(Res[type])),\n Check=if Type<>\"container\" then error \"Expected a Build Artifact file container\" else true,\n Parts=Text.Split(Text.From(Res[data]),\"/\"),\n ContainerId=Parts{1},\n Raw=if Check then Web.Contents(\"https://dev.azure.com\",[RelativePath=C[Organization]&\"/_apis/resources/Containers/\"&ContainerId&\"/\"&C[ArtifactName],Query=[itemPath=C[ArtifactName]&\"/\"&C[SarifFileName]],Headers=[Accept=\"application/octet-stream\"]]) else error \"Invalid artifact\",\n S=Json.Document(Raw)\nin S",
        "lineageTag": "77aaf30d-e178-45c9-a05e-ff413dc51857"
      },
      {
        "name": "fxRawJsonFiles",
        "kind": "m",
        "expression": "(buildId as number) as table =>\nlet\n    C = Config,\n    Endpoint = C[Organization] & \"/\" & Uri.EscapeDataString(C[Project])\n        & \"/_apis/build/builds/\" & Text.From(buildId) & \"/artifacts\",\n    Artifact = fxAzDoGet(Endpoint, [artifactName = C[RawArtifactName]]),\n    Resource = Artifact[resource],\n    ArtifactType = Text.Lower(Text.From(Resource[type])),\n    ManifestId = if ArtifactType = \"pipelineartifact\"\n        then Text.From(Resource[data])\n        else error \"Expected a PipelineArtifact (PublishPipelineArtifact).\",\n    FetchFile = (fileId as text, fileName as text) as binary =>\n        Web.Contents(\"https://dev.azure.com\", [\n            RelativePath = Endpoint,\n            Query = [\n                artifactName = C[RawArtifactName],\n                fileId = fileId,\n                fileName = fileName,\n                #\"api-version\" = \"7.1\"\n            ],\n            Headers = [Accept = \"application/octet-stream\"]\n        ]),\n    Manifest = Json.Document(FetchFile(ManifestId, \"manifest.json\")),\n    Items = Record.FieldOrDefault(Manifest, \"items\", {}),\n    JsonItems = List.Select(Items, each\n        Text.EndsWith(Text.Lower(Text.From(Record.FieldOrDefault(_, \"path\", \"\"))), \".json\")\n        and Record.HasFields(_, \"blob\")),\n    Rows = List.Transform(JsonItems, (item) =>\n        let\n            ItemPath = Text.From(item[path]),\n            BlobId = Text.From(item[blob][id]),\n            Bytes = FetchFile(BlobId, List.Last(Text.Split(ItemPath, \"/\"))),\n            Parsed = Json.Document(Bytes)\n        in\n            [BuildId = buildId, FilePath = ItemPath, RawJson = Json.FromValue(Parsed)]\n    ),\n    Output = if List.IsEmpty(Rows)\n        then #table({\"BuildId\", \"FilePath\", \"RawJson\"}, {})\n        else Table.FromRecords(Rows)\nin\n    Output"
      }
    ]
  }
}
