          },
          {
            "name": "Value",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "9e40a1f5-6377-422d-9675-d2a78c1553d0",
            "sourceColumn": "Value",
            "summarizeBy": "none"
          }
        ],
        "isHidden": true,
        "lineageTag": "c14cf1c0-7d3e-436f-a51c-0395d98fdb65",
        "partitions": [
          {
            "name": "Config",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Config = [",
                "        Organization = \"ai-experiments\",",
                "        Project = \"PSRule.Rules.AzureDevOps\",",
                "        PipelineDefinitionId = 19,",
                "        ArtifactName = \"psrule-results\",",
                "        SarifFileName = \"psrule-results.sarif\",",
                "        RawArtifactName = \"AzureDevOpsRawData\",",
                "        MaxBuilds = 1",
                "    ]",
                "in",
                "    Config"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "Builds",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "id",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "4b604eb8-898d-41a8-be05-450ddea0936f",
            "sourceColumn": "id",
            "summarizeBy": "none"
          },
          {
            "name": "buildNumber",
            "dataType": "string",
            "lineageTag": "4de22989-eb39-47cb-8f76-87beef3c5dcf",
            "sourceColumn": "buildNumber"
          },
          {
            "name": "finishTime",
            "dataType": "string",
            "lineageTag": "32b85895-47e7-4ee2-8814-10d408292f8",
            "sourceColumn": "finishTime"
          },
          {
            "name": "result",
            "dataType": "string",
            "lineageTag": "7ccca636-b9c3-4a3c-aff3-ccd68516f31a",
            "sourceColumn": "result"
          }
        ],
        "lineageTag": "16f9543f-a51e-4ca7-ab1d-e7054dc8f00d",
        "partitions": [
          {
            "name": "Builds",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "  C=Config,",
                "  Valid=if C[PipelineDefinitionId]=0 then error \"Configure PipelineDefinitionId in Config\" else true,",
                "  R=if Valid then fxAzDoGet(C[Organization]&\"/\"&Uri.EscapeDataString(C[Project])&\"/_apis/build/builds\", [definitions=Text.From(C[PipelineDefinitionId]), statusFilter=\"completed\", queryOrder=\"finishTimeDescending\", #\"$top\"=Text.From(C[MaxBuilds])]) else null,",
                "  L=R[value],",
                "  T=Table.FromRecords(L, null, MissingField.UseNull),",
                "  Output=Table.SelectColumns(T,{\"id\",\"buildNumber\",\"finishTime\",\"result\"}, MissingField.UseNull)",
                "in Output"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "AssessmentResults",
        "columns": [
          {
            "name": "BuildId",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "fe5db2c4-82fc-49c8-8a0b-6e8f7701d226",
            "sourceColumn": "BuildId",
            "summarizeBy": "none"
          },
          {
            "name": "BuildNumber",
            "dataType": "string",
            "lineageTag": "20c4f4a6-3fbb-41d7-8c49-54f221a7081e",
            "sourceColumn": "BuildNumber"
          },
          {
            "name": "RuleId",
            "dataType": "string",
            "lineageTag": "db372f45-c589-4cd3-a6c6-eb83dfbc81b7",
            "sourceColumn": "RuleId"
          },
          {
            "name": "Level",
            "dataType": "string",
            "lineageTag": "b2b226e3-1cda-4509-ac4b-a4a986ff7aa0",
            "sourceColumn": "Level"
          },
          {
            "name": "Kind",
            "dataType": "string",
            "lineageTag": "2186b0b1-e926-4f90-baed-41b95aa15be6",
            "sourceColumn": "Kind"
          },
          {
            "name": "Message",
            "dataType": "string",
            "lineageTag": "6ab4f4be-03c6-4bbb-b3da-78f5ac8b9de4",
            "sourceColumn": "Message"
          },
          {
            "name": "TargetUri",
            "dataType": "string",
            "lineageTag": "f93c1ec7-6e93-482f-a8d5-03a028830bce",
            "sourceColumn": "TargetUri"
          }
        ],
        "lineageTag": "4715acc5-db69-43a2-92ef-217630e99147",
        "measures": [
          {
            "name": "Reported Findings",
            "expression": "COUNTROWS(AssessmentResults)",
            "formatString": "#,0",
            "lineageTag": "ba276ffd-7dc0-4769-8293-d0592fb45a79"
          },
          {
            "name": "Affected Rules",
            "expression": "DISTINCTCOUNT(AssessmentResults[RuleId])",
            "formatString": "#,0",
            "lineageTag": "0018a5ca-a7d8-43f0-8130-671e6797ade6"
          },
          {
            "name": "Error Findings",
            "expression": "CALCULATE([Reported Findings], AssessmentResults[Level] = \"error\")",
            "formatString": "#,0",
            "lineageTag": "bcd67055-123d-451b-aab8-52ddabde15ac"
          }
        ],
        "partitions": [
          {
            "name": "AssessmentResults",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "  Bs=Table.ToRecords(Builds),",
                "  Rows=List.Combine(List.Transform(Bs,(b)=>",
                "    let",
                "      Sarif=fxArtifactSarif(b[id]),",
                "      Runs=Record.FieldOrDefault(Sarif,\"runs\",{}),",
                "      Found=List.Combine(List.Transform(Runs,(run)=>List.Transform(Record.FieldOrDefault(run,\"results\",{}),(r)=>",
                "        let",
                "          Msg=Record.FieldOrDefault(r,\"message\",[]),",
                "          Locs=Record.FieldOrDefault(r,\"locations\",{}),",
                "          Loc=if List.Count(Locs)>0 then Locs{0} else [],",
                "          Ph=Record.FieldOrDefault(Loc,\"physicalLocation\",[]),",
                "          Ar=Record.FieldOrDefault(Ph,\"artifactLocation\",[])",
                "        in [BuildId=b[id],BuildNumber=b[buildNumber],RuleId=Record.FieldOrDefault(r,\"ruleId\",null),Level=Record.FieldOrDefault(r,\"level\",null),Kind=Record.FieldOrDefault(r,\"kind\",null),Message=Record.FieldOrDefault(Msg,\"text\",null),TargetUri=Record.FieldOrDefault(Ar,\"uri\",null)]",
                "      )))",
                "    in Found",
                "  )),",
                "  Output=if List.Count(Rows)=0 then #table({\"BuildId\",\"BuildNumber\",\"RuleId\",\"Level\",\"Kind\",\"Message\",\"TargetUri\"},{}) else Table.FromRecords(Rows)",
                "in Output"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "RawFilesText",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
