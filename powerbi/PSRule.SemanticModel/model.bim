            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "BuildId",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "formatString": "0",
            "lineageTag": "e7200e69-caf8-4f60-808b-111e60c6f16a",
            "sourceColumn": "BuildId",
            "summarizeBy": "count"
          },
          {
            "name": "FilePath",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "a6d78fd6-bbb7-4364-ac1c-7aedcfd34c64",
            "sourceColumn": "FilePath",
            "summarizeBy": "none"
          },
          {
            "name": "RawJson",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "68b9f6b8-bdab-4257-aa96-60b0b4a9a570",
            "sourceColumn": "RawJson",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "be957697-01e0-4529-a87b-d3e35c5b1574",
        "partitions": [
          {
            "name": "RawFilesText",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Runs = Table.ToRecords(Builds),",
                "",
                "    Tables = List.Transform(",
                "        Runs,",
                "        each fxRawJsonFiles(_[id])",
                "    ),",
                "",
                "    Combined =",
                "        if List.IsEmpty(Tables) then",
                "            #table(",
                "                {\"BuildId\", \"FilePath\", \"RawJson\"},",
                "                {}",
                "            )",
                "        else",
                "            Table.Combine(Tables),",
                "",
                "    AsText = Table.TransformColumns(",
                "        Combined,",
                "        {",
                "            {",
                "                \"RawJson\",",
                "                each Text.FromBinary(",
                "                    _,",
                "                    TextEncoding.Utf8",
                "                ),",
                "                type text",
                "            }",
                "        }",
                "    ),",
                "",
                "    Output = Table.TransformColumnTypes(",
                "        Table.SelectColumns(",
                "            AsText,",
                "            {\"BuildId\", \"FilePath\", \"RawJson\"}",
                "        ),",
                "        {",
                "            {\"BuildId\", Int64.Type},",
                "            {\"FilePath\", type text},",
                "            {\"RawJson\", type text}",
                "        }",
                "    )",
                "in",
                "    Output"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
