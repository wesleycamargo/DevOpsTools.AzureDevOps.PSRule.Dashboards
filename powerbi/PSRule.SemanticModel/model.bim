{
  "compatibilityLevel": 1606,
  "model": {
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "1"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Config\",\"Builds\",\"AssessmentResults\",\"RawFiles\",\"fxAzDoGet\",\"fxArtifactSarif\",\"fxRawJsonFiles\",\"RawFilesText\"]"
      }
    ],
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "fxAzDoGet",
        "expression": "(path as text, q as record) as any => Json.Document(Web.Contents(\"https://dev.azure.com\", [RelativePath=path, Query=Record.Combine({[#\"api-version\"=\"7.1\"],q}), Headers=[Accept=\"application/json\"]]))",
        "kind": "m",
        "lineageTag": "a1cdfb02-74eb-46a4-b516-ae9184baaa3e"
      },
      {
        "name": "fxArtifactSarif",
        "expression": [
          "(buildId as number) as record =>",
          "let",
          " C=Config,",
          " Path=C[Organization]&\"/\"&Uri.EscapeDataString(C[Project])&\"/_apis/build/builds/\"&Text.From(buildId)&\"/artifacts\",",
          " Info=fxAzDoGet(Path,[artifactName=C[ArtifactName]]),",
          " Res=Info[resource],",
          " Type=Text.Lower(Text.From(Res[type])),",
          " Check=if Type<>\"container\" then error \"Expected a Build Artifact file container\" else true,",
          " Parts=Text.Split(Text.From(Res[data]),\"/\"),",
          " ContainerId=Parts{1},",
          " Raw=if Check then Web.Contents(\"https://dev.azure.com\",[RelativePath=C[Organization]&\"/_apis/resources/Containers/\"&ContainerId&\"/\"&C[ArtifactName],Query=[itemPath=C[ArtifactName]&\"/\"&C[SarifFileName]],Headers=[Accept=\"application/octet-stream\"]]) else error \"Invalid artifact\",",
          " S=Json.Document(Raw)",
          "in S"
        ],
        "kind": "m",
        "lineageTag": "77aaf30d-e178-45c9-a05e-ff413dc51857"
      },
      {
        "name": "fxRawJsonFiles",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Function"
          }
        ],
        "expression": [
          "(buildId as number) as table =>",
          "let",
          "    C = Config,",
          "",
          "    // Get artifact metadata",
          "    ArtifactEndpoint =",
          "        C[Organization] & \"/\" &",
          "        Uri.EscapeDataString(C[Project]) &",
          "        \"/_apis/build/builds/\" &",
          "        Text.From(buildId) &",
          "        \"/artifacts\",",
          "",
          "    Artifact = fxAzDoGet(",
          "        ArtifactEndpoint,",
          "        [artifactName = C[RawArtifactName]]",
          "    ),",
          "",
          "    Resource = Artifact[resource],",
          "",
          "    ArtifactType = Text.Lower(",
          "        Text.From(Resource[type])",
          "    ),",
          "",
          "    Parts = Text.Split(",
          "        Text.From(Resource[data]),",
          "        \"/\"",
          "    ),",
          "",
          "    ContainerId =",
          "        if ArtifactType = \"container\"",
          "            and List.Count(Parts) > 1",
          "        then",
          "            Parts{1}",
          "        else",
          "            error \"Expected a File Container artifact.\",",
          "",
          "    Root = C[RawArtifactName],",
          "",
          "    ContainerEndpoint =",
          "        C[Organization] &",
          "        \"/_apis/resources/Containers/\" &",
          "        ContainerId & \"/\" & Root,",
          "",
          "    // List files recursively",
          "    Listing = Json.Document(",
          "        Web.Contents(",
          "            \"https://dev.azure.com\",",
          "            [",
          "                RelativePath = ContainerEndpoint,",
          "                Query = [",
          "                    itemPath = Root,",
          "                    isShallow = \"false\",",
          "                    #\"$format\" = \"json\",",
          "                    #\"api-version\" = \"7.1-preview\"",
          "                ],",
          "                Headers = [",
          "                    Accept = \"application/json\"",
          "                ]",
          "            ]",
          "        )",
          "    ),",
          "",
          "    Items =",
          "        if Value.Is(Listing, type list) then",
          "            Listing",
          "        else",
          "            Record.FieldOrDefault(",
          "                Listing,",
          "                \"value\",",
          "                {}",
          "            ),",
          "",
          "    // Find JSON files",
          "    JsonItems = List.Select(",
          "        Items,",
          "        each Text.EndsWith(",
          "            Text.Lower(",
          "                Text.From(",
          "                    Record.FieldOrDefault(_, \"path\", \"\")",
          "                )",
          "            ),",
          "            \".json\"",
          "        )",
          "    ),",
          "",
          "    // Download and parse each JSON",
          "    Rows = List.Transform(",
          "        JsonItems,",
          "        (item) =>",
          "            let",
          "                ItemPath = Text.From(item[path]),",
          "",
          "                Raw = Web.Contents(",
          "                    \"https://dev.azure.com\",",
          "                    [",
          "                        RelativePath = ContainerEndpoint,",
          "                        Query = [",
          "                            itemPath = ItemPath",
          "                        ],",
          "                        Headers = [",
          "                            Accept = \"application/octet-stream\"",
          "                        ]",
          "                    ]",
          "                ),",
          "",
          "                Parsed = Json.Document(Raw)",
          "            in",
          "                [",
          "                    BuildId = buildId,",
          "                    FilePath = ItemPath,",
          "                    RawJson = Json.FromValue(Parsed)",
          "                ]",
          "    ),",
          "",
          "    Output =",
          "        if List.IsEmpty(Rows) then",
          "            #table(",
          "                {\"BuildId\", \"FilePath\", \"RawJson\"},",
          "                {}",
          "            )",
          "        else",
          "            Table.FromRecords(Rows)",
          "in",
          "    Output"
        ],
        "kind": "m",
        "lineageTag": "9722e64c-384c-44dc-b9dc-7c86d8def877"
      },
      {
        "name": "RawFiles",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    Runs = Table.ToRecords(Builds),",
          "",
          "    Tables = List.Transform(",
          "        Runs,",
          "        each fxRawJsonFiles(_[id])",
          "    ),",
          "",
          "    Combined =",
          "        if List.IsEmpty(Tables) then",
          "            #table(",
          "                {\"BuildId\", \"FilePath\", \"RawJson\"},",
          "                {}",
          "            )",
          "        else",
          "            Table.Combine(Tables),",
          "",
          "    AsText = Table.TransformColumns(",
          "        Combined,",
          "        {",
          "            {",
          "                \"RawJson\",",
          "                each Text.FromBinary(",
          "                    _,",
          "                    TextEncoding.Utf8",
          "                ),",
          "                type text",
          "            }",
          "        }",
          "    ),",
          "",
          "    Output = Table.TransformColumnTypes(",
          "        Table.SelectColumns(",
          "            AsText,",
          "            {\"BuildId\", \"FilePath\", \"RawJson\"}",
          "        ),",
          "        {",
          "            {\"BuildId\", Int64.Type},",
          "            {\"FilePath\", type text},",
          "            {\"RawJson\", type text}",
          "        }",
          "    )",
          "in",
          "    Output"
        ],
        "kind": "m",
        "lineageTag": "bc3368d1-ffd6-4335-8440-3c786d0d9c79"
      }
    ],
    "sourceQueryCulture": "pt-BR",
    "tables": [
      {
        "name": "Config",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Record"
          }
        ],
        "columns": [
          {
            "name": "Name",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "lineageTag": "cc952827-3122-4212-9c5d-77fc1b397d7b",
            "sourceColumn": "Name",
